# ──────────────────────────────────────────────────────────────
# PayLoop – Environment Variables
# Copy this file to .env and fill in the real values.
# ──────────────────────────────────────────────────────────────

# Django core
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL recommended; omit to fall back to SQLite)
DATABASE_URL=postgres://user:password@localhost:5432/payloop

# ── M-Pesa via PayHero aggregator ────────────────────────────
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=

# ── Blockchain / Polygon Amoy Testnet ────────────────────────
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
BACKEND_WALLET_PRIVATE_KEY=

# ── Smart Contract Addresses ─────────────────────────────────
CIRCLE_VAULT_ADDRESS=
LENDING_POOL_ADDRESS=
CREDIT_SCORE_ADDRESS=
LOOP_TOKEN_ADDRESS=

# ── Firebase ─────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=
