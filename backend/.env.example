# ──────────────────────────────────────────────────────────────
# PayLoop – Environment Variables
# Copy this file to .env and fill in the real values.
# ──────────────────────────────────────────────────────────────

# Django core
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL recommended; uncomment and set for production)
# DATABASE_URL=postgres://user:password@localhost:5432/payloop

# ── M-Pesa via Safaricom Daraja API ──────────────────────────
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-daraja-passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback/
MPESA_ENV=sandbox

# ── Blockchain / Polygon Amoy Testnet ────────────────────────
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
BACKEND_WALLET_PRIVATE_KEY=your-backend-wallet-private-key

# ── Smart Contract Addresses ─────────────────────────────────
CIRCLE_VAULT_ADDRESS=0x9F2196B0dF4e5cEE0E43d19F185602c22055F4eD
LENDING_POOL_ADDRESS=0xfFD93d42d303D1D9443732c81022659656490Ce8
CREDIT_SCORE_ADDRESS=0xbfeD8Ff69F68935b402ae95AeE2C0DD9A4e25C71
LOOP_TOKEN_ADDRESS=0x856BB4c9186515b4Cef937B82E50c84153139774

# ── Firebase ─────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json
