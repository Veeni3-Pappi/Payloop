<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Obsidian Flux: dark, no action bar. Compose owns the real theming;
         this just sets a matching launch background + dark system bars. -->
    <style name="Theme.Payloop" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/obsidian_bg</item>
        <item name="android:statusBarColor">@color/obsidian_bg</item>
        <item name="android:navigationBarColor">@color/obsidian_bg</item>
    </style>
</resources>
